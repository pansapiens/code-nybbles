{
  "name": "code-nybbles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @code-nybbles/app dev",
    "build": "pnpm content:build && pnpm --filter @code-nybbles/app build",
    "test": "pnpm -r --if-present run test",
    "type-check": "pnpm -r --if-present run type-check",
    "content:build": "pnpm --filter @code-nybbles/content-build build",
    "content:check": "pnpm --filter @code-nybbles/content-build check"
  }
}
